          "images": {
            "icon": {
              "path": "plugin/assets/icon.png",
              "alt": "Persona Studio",
              "sha256": "5b91a62de8f401de297757803c6c9d42fae618fbc705f0b849de36028f327487",
              "width": 256,
              "height": 256
            },
            "cover": {
              "path": "plugin/assets/cover.png",
              "alt": "The Persona Studio tab: a project's new findings, what each persona saw on the open one, and the personas with their new findings.",
              "sha256": "ef7204ee2ab184fdd97c5d94627cb5c9ec68833837d9a04e41b00810109d45af",
              "width": 1600,
              "height": 1000
            }
          }
