        "url": "https://github.com/jejacks0n/orca-persona-studio.git",
        "ref": "main",
        "path": "plugin"
      },
      "description": "Personas use your app in Orca's browser and bring back the bugs, missing pieces and rough edges that got in their way.",
      "categories": [
        "panels",
        "testing",
        "agents"
      ],
      "releases": [
        {
          "version": "0.1.0",
          "commit": "841de831945dc254d808bc1bda8f9ff8cb79df1b",
          "contentHash": "ac36c77068a77c5482a00fb36513878d541d3a66367875117347316ab1b91b2f",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "Persona Studio",
          "contributes": [
            {
              "kind": "panels",
              "name": "Persona Studio"
            },
            {
              "kind": "commands",
              "name": "Persona Studio: open the tab"
            },
            {
              "kind": "commands",
              "name": "Persona Studio: what needs me"
            },
            {
              "kind": "events",
              "name": "agent.status.changed"
            },
            {
              "kind": "events",
              "name": "workspace.changed"
            },
            {
              "kind": "syntaxes",
              "name": "JSON",
              "detail": "persona.studio"
            },
            {
              "kind": "customEditors",
              "name": "Persona Studio",
              "detail": "persona.studio"
            }
          ],
          "capabilities": [
            "storage:own",
            "settings:own",
            "notifications:show",
            "agent:launch",
            "agent:read",
            "workspace:read",
            "workspace:write"
